{
	"permissions": {
		"allow": [
			"Bash(pnpm dev)",
			"Bash(pnpm build)",
			"Bash(pnpm lint)",
			"Bash(pnpm format)",
			"Bash(pnpm prepare)",
			"Bash(npx biome *)",
			"Bash(npx tsc --noEmit)",
			"Bash(git status*)",
			"Bash(git log*)",
			"Bash(git diff*)",
			"Bash(git branch*)",
			"Bash(git add *)",
			"Bash(git commit *)",
			"Bash(git checkout -b *)",
			"Bash(git switch *)",
			"Bash(git stash*)",
			"Bash(ls *)",
			"Bash(wc *)"
		],
		"deny": [
			"Bash(git push --force*)",
			"Bash(git push -f*)",
			"Bash(git reset --hard*)",
			"Bash(rm -rf *)",
			"Bash(rm -r *)",
			"Bash(cat .env*)",
			"Bash(cat *.env*)",
			"Bash(*> .env*)",
			"Bash(chmod *)",
			"Bash(curl *| bash*)",
			"Bash(wget *| bash*)"
		]
	},
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bash .claude/hooks/session-start-check.sh",
						"timeout": 5000
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Write|Edit",
				"hooks": [
					{
						"type": "command",
						"command": "npx biome check --write --no-errors-on-unmatched $CLAUDE_FILE_PATH 2>/dev/null || true",
						"timeout": 10000
					}
				]
			}
		],
		"PreCommit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "npx tsc --noEmit",
						"timeout": 30000
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "bash .claude/hooks/pre-commit-sync-check.sh",
						"timeout": 5000
					}
				]
			}
		]
	}
}
